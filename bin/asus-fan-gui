#!/usr/bin/env python3
"""
ASUS Thermal & Cooling Center
Real-time hardware monitoring and thermal profile manager for ASUS laptops.
"""

import os
import sys
import glob
import subprocess
import gi

gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, GLib, Gdk

def get_hwmon_path(name):
    for p in glob.glob('/sys/class/hwmon/hwmon*'):
        try:
            with open(os.path.join(p, 'name'), 'r') as f:
                if f.read().strip() == name:
                    return p
        except Exception:
            pass
    return None

def read(path, default=None):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default

def ac_online():
    for p in glob.glob('/sys/class/power_supply/*'):
        if read(os.path.join(p, 'type')) == 'Mains' and read(os.path.join(p, 'online')) == '1':
            return True
    return False

def battery_limit():
    for p in sorted(glob.glob('/sys/class/power_supply/*/charge_control_end_threshold')):
        return read(p)
    return None

# ACPI platform profile -> power-profiles-daemon name
PLATFORM_TO_PPD = {'performance': 'performance', 'quiet': 'power-saver',
                   'low-power': 'power-saver', 'cool': 'power-saver'}

class FanControlWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title="ASUS Thermal & Cooling Center")
        self.set_default_size(530, 580)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_resizable(False)
        self.set_border_width(18)
        self.set_icon_name("preferences-system-power")

        self.asus_hwmon = get_hwmon_path('asus')
        self.core_hwmon = get_hwmon_path('coretemp')

        # Modern CSS styling
        css_provider = Gtk.CssProvider()
        css = """
        .card {
            background-color: @theme_base_color;
            border-radius: 12px;
            border: 1px solid alpha(@theme_fg_color, 0.12);
            padding: 16px;
        }
        .metric-title {
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.5px;
            opacity: 0.65;
        }
        .metric-value-temp, .metric-value-fan {
            font-size: 34px;
            font-weight: 700;
        }
        .section-title {
            font-size: 15px;
            font-weight: 700;
            margin-bottom: 8px;
        }
        .status-badge {
            font-size: 12px;
            padding: 3px 8px;
            border-radius: 6px;
            font-weight: 600;
        }
        .desc-text {
            font-size: 12px;
            opacity: 0.75;
        }
        """
        css_provider.load_from_data(css.encode())
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            css_provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        self.add(main_box)

        # 1. Header Metrics Card
        metrics_card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=20)
        metrics_card.get_style_context().add_class('card')
        metrics_card.set_homogeneous(True)

        # Temperature Box
        temp_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        t_title = Gtk.Label(label="CPU TEMPERATURE")
        t_title.get_style_context().add_class('metric-title')
        t_title.set_xalign(0.5)
        self.temp_label = Gtk.Label()
        self.temp_label.set_use_markup(True)
        self.temp_label.get_style_context().add_class('metric-value-temp')
        self.temp_status = Gtk.Label(label="Optimal")
        self.temp_status.get_style_context().add_class('status-badge')
        temp_box.pack_start(t_title, False, False, 0)
        temp_box.pack_start(self.temp_label, False, False, 0)
        temp_box.pack_start(self.temp_status, False, False, 0)
        metrics_card.pack_start(temp_box, True, True, 0)

        # Fan Speed Box
        fan_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        f_title = Gtk.Label(label="FAN SPEED")
        f_title.get_style_context().add_class('metric-title')
        f_title.set_xalign(0.5)
        self.fan_label = Gtk.Label()
        self.fan_label.set_use_markup(True)
        self.fan_label.get_style_context().add_class('metric-value-fan')
        self.fan_pct_label = Gtk.Label(label="-- % Output")
        self.fan_pct_label.get_style_context().add_class('status-badge')
        fan_box.pack_start(f_title, False, False, 0)
        fan_box.pack_start(self.fan_label, False, False, 0)
        fan_box.pack_start(self.fan_pct_label, False, False, 0)
        metrics_card.pack_start(fan_box, True, True, 0)

        main_box.pack_start(metrics_card, False, False, 0)

        # Progress bar for fan speed
        self.fan_progress = Gtk.ProgressBar()
        self.fan_progress.set_show_text(False)
        main_box.pack_start(self.fan_progress, False, False, 0)

        # 2. Thermal Profiles Card
        profiles_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        profiles_card.get_style_context().add_class('card')

        p_title = Gtk.Label(label="Thermal & Acoustic Profile (Hardware EC)")
        p_title.get_style_context().add_class('section-title')
        p_title.set_xalign(0)
        profiles_card.pack_start(p_title, False, False, 0)

        # Option Performance
        box_perf = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        self.radio_perf = Gtk.RadioButton.new_from_widget(None)
        lbl_perf = Gtk.Label()
        lbl_perf.set_markup("<b>Performance (Maximum Cooling / Overboost)</b>")
        lbl_perf.set_xalign(0)
        self.radio_perf.add(lbl_perf)
        self.radio_perf.connect("toggled", self.on_profile_changed, "performance")
        perf_desc = Gtk.Label(label="     Proactive cooling. Ramps up to 5000+ RPM at 80-85°C to eliminate thermal throttling.")
        perf_desc.set_xalign(0)
        perf_desc.get_style_context().add_class('desc-text')
        box_perf.pack_start(self.radio_perf, False, False, 0)
        box_perf.pack_start(perf_desc, False, False, 0)
        profiles_card.pack_start(box_perf, False, False, 0)

        # Option Balanced
        box_bal = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        self.radio_bal = Gtk.RadioButton.new_from_widget(self.radio_perf)
        lbl_bal = Gtk.Label()
        lbl_bal.set_markup("<b>Balanced (Standard Dynamic Cooling)</b>")
        lbl_bal.set_xalign(0)
        self.radio_bal.add(lbl_bal)
        self.radio_bal.connect("toggled", self.on_profile_changed, "balanced")
        bal_desc = Gtk.Label(label="     Intelligent balance of acoustics and thermals (Default on battery power).")
        bal_desc.set_xalign(0)
        bal_desc.get_style_context().add_class('desc-text')
        box_bal.pack_start(self.radio_bal, False, False, 0)
        box_bal.pack_start(bal_desc, False, False, 0)
        profiles_card.pack_start(box_bal, False, False, 0)

        # Option Quiet
        box_quiet = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        self.radio_quiet = Gtk.RadioButton.new_from_widget(self.radio_perf)
        lbl_quiet = Gtk.Label()
        lbl_quiet.set_markup("<b>Quiet / Silent (Whisper-Quiet Operation)</b>")
        lbl_quiet.set_xalign(0)
        self.radio_quiet.add(lbl_quiet)
        self.radio_quiet.connect("toggled", self.on_profile_changed, "power-saver")
        quiet_desc = Gtk.Label(label="     Minimizes fan noise; keeps fan low or idle for distraction-free environments.")
        quiet_desc.set_xalign(0)
        quiet_desc.get_style_context().add_class('desc-text')
        box_quiet.pack_start(self.radio_quiet, False, False, 0)
        box_quiet.pack_start(quiet_desc, False, False, 0)
        profiles_card.pack_start(box_quiet, False, False, 0)

        main_box.pack_start(profiles_card, False, False, 0)

        # 3. Reference Table Expander
        expander = Gtk.Expander()
        exp_header = Gtk.Label()
        exp_header.set_markup("<b>Thermal Curve Reference (Performance Mode)</b>")
        expander.set_label_widget(exp_header)

        exp_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        exp_box.set_border_width(8)

        table_data = [
            ("40°C — 45°C", "Tier 1: Standby / Idle", "~2200 – 2600 RPM"),
            ("55°C — 65°C", "Tier 2: Active Airflow", "~3000 – 3400 RPM"),
            ("70°C — 80°C", "Tier 3: High-Power Cooling", "~3800 – 4400 RPM"),
            ("85°C and above", "Tier 4: Emergency Turbo Boost", "5000+ RPM"),
        ]

        grid = Gtk.Grid()
        grid.set_column_spacing(20)
        grid.set_row_spacing(6)
        
        h1 = Gtk.Label(label="<b>Temperature</b>", use_markup=True, xalign=0)
        h2 = Gtk.Label(label="<b>Cooling Stage</b>", use_markup=True, xalign=0)
        h3 = Gtk.Label(label="<b>Fan Target Speed</b>", use_markup=True, xalign=0)
        grid.attach(h1, 0, 0, 1, 1)
        grid.attach(h2, 1, 0, 1, 1)
        grid.attach(h3, 2, 0, 1, 1)

        for row_idx, (t, s, r) in enumerate(table_data, start=1):
            l1 = Gtk.Label(label=t, xalign=0)
            l2 = Gtk.Label(label=s, xalign=0)
            l3 = Gtk.Label(label=f"<b>{r}</b>", use_markup=True, xalign=0)
            grid.attach(l1, 0, row_idx, 1, 1)
            grid.attach(l2, 1, row_idx, 1, 1)
            grid.attach(l3, 2, row_idx, 1, 1)

        exp_box.pack_start(grid, False, False, 0)
        expander.add(exp_box)
        main_box.pack_start(expander, False, False, 0)

        # 4. Status Bar at Bottom
        self.power_status_label = Gtk.Label(label="Detecting power source...")
        self.power_status_label.set_xalign(0.5)
        self.power_status_label.get_style_context().add_class('metric-title')
        main_box.pack_start(self.power_status_label, False, False, 0)

        self.is_updating_ui = False
        self.update_stats()
        GLib.timeout_add(1500, self.update_stats)

    def get_current_profile(self):
        # Cheap sysfs read instead of spawning powerprofilesctl every refresh.
        plat = read('/sys/firmware/acpi/platform_profile')
        if plat is not None:
            return PLATFORM_TO_PPD.get(plat, 'balanced')
        try:
            res = subprocess.run(['powerprofilesctl', 'get'], capture_output=True, text=True)
            return res.stdout.strip() or 'balanced'
        except OSError:
            return 'balanced'

    def on_profile_changed(self, button, profile_name):
        if self.is_updating_ui or not button.get_active():
            return
        try:
            subprocess.run(['powerprofilesctl', 'set', profile_name], check=True)
        except Exception as e:
            print(f"Error setting profile {profile_name}: {e}")

    def update_stats(self):
        # 1. Temperature
        temp_c = 0
        if self.core_hwmon:
            try:
                with open(os.path.join(self.core_hwmon, 'temp1_input'), 'r') as f:
                    temp_c = int(f.read().strip()) // 1000
            except Exception:
                pass
        
        if temp_c < 60:
            self.temp_status.set_text("Optimal / Cool")
            self.temp_label.set_markup(f"<span color='#16a34a' font_weight='bold'>{temp_c} °C</span>")
        elif temp_c < 80:
            self.temp_status.set_text("Moderate Load")
            self.temp_label.set_markup(f"<span color='#d97706' font_weight='bold'>{temp_c} °C</span>")
        else:
            self.temp_status.set_text("High Load (Active)")
            self.temp_label.set_markup(f"<span color='#dc2626' font_weight='bold'>{temp_c} °C</span>")

        # 2. Fan Speed
        fan_rpm = 0
        if self.asus_hwmon:
            try:
                with open(os.path.join(self.asus_hwmon, 'fan1_input'), 'r') as f:
                    fan_rpm = int(f.read().strip())
            except Exception:
                pass

        self.fan_label.set_markup(f"<span color='#2563eb' font_weight='bold'>{fan_rpm} RPM</span>")
        max_fan_rpm = 5500
        fraction = min(max(fan_rpm / max_fan_rpm, 0.0), 1.0)
        self.fan_progress.set_fraction(fraction)
        self.fan_pct_label.set_text(f"{int(fraction * 100)}% Output")

        # 3. Active Profile
        current_profile = self.get_current_profile()
        self.is_updating_ui = True
        if current_profile == 'performance':
            self.radio_perf.set_active(True)
        elif current_profile == 'power-saver':
            self.radio_quiet.set_active(True)
        else:
            self.radio_bal.set_active(True)
        self.is_updating_ui = False

        # 4. AC Online, battery limit, auto-switch rule
        power_text = "AC Connected" if ac_online() else "On Battery Power"
        limit_val = battery_limit()
        parts = [power_text]
        if limit_val:
            parts.append(f"Battery Limit: {limit_val}%")
        if os.path.exists('/etc/udev/rules.d/98-powerprofile-switch.rules'):
            parts.append("Auto-Switch Active")
        self.power_status_label.set_text("  •  ".join(parts))

        return True

def main():
    win = FanControlWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()

if __name__ == '__main__':
    main()
