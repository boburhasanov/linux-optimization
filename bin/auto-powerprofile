#!/usr/bin/env bash
# Auto-switch power profile on AC plug/unplug (called by udev, runs once per event).
ONLINE=0
for s in /sys/class/power_supply/*; do
    if [ "$(cat "$s/type" 2>/dev/null)" = "Mains" ] && [ "$(cat "$s/online" 2>/dev/null)" = "1" ]; then
        ONLINE=1
        break
    fi
done

if [ "$ONLINE" = "1" ]; then
    /usr/bin/powerprofilesctl set performance 2>/dev/null || true
else
    /usr/bin/powerprofilesctl set balanced 2>/dev/null || true
fi
