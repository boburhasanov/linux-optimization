#!/usr/bin/env python3
"""
ASUS Battery Health & Charge Limiter GUI
Native GTK3 utility for configuring hardware charge thresholds on ASUS laptops.
Privileged writes go through pkexec -> /usr/local/bin/bat-limit (polkit prompt).
"""

import glob
import os
import subprocess
import gi

gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, GLib, Gdk

BAT_LIMIT = '/usr/local/bin/bat-limit'
OPTIONS = [
    ("60", "60% — Maximum Longevity", "Best when the laptop stays on the charger most of the day.", False),
    ("80", "80% — Balanced Protection", "Optimal balance of daily runtime and battery lifespan.", True),
    ("100", "100% — Full Capacity", "Charge fully for travel; switch back afterwards.", False),
]

CSS = """
.card {
    background-color: @theme_base_color;
    border-radius: 12px;
    border: 1px solid alpha(@theme_fg_color, 0.12);
    padding: 18px;
}
.metric-title { font-size: 12px; font-weight: 700; letter-spacing: 0.5px; opacity: 0.65; }
.metric-value-bat { font-size: 34px; font-weight: 700; color: #3b82f6; }
.metric-value-lim { font-size: 34px; font-weight: 700; color: #22c55e; }
.section-title { font-size: 15px; font-weight: 700; }
.desc-text { font-size: 12px; opacity: 0.75; }
.recommended { color: #22c55e; font-weight: 700; }
"""


def find_battery():
    for p in sorted(glob.glob('/sys/class/power_supply/*')):
        if os.path.exists(os.path.join(p, 'charge_control_end_threshold')):
            return p
    return None


def read(path, default=None):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def ac_online():
    for p in glob.glob('/sys/class/power_supply/*'):
        if read(os.path.join(p, 'type')) == 'Mains' and read(os.path.join(p, 'online')) == '1':
            return True
    return False


class BatteryLimitWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title="ASUS Battery Health & Charge Limiter")
        self.set_default_size(520, 500)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_resizable(False)
        self.set_border_width(18)
        self.set_icon_name("battery-good-symbolic")
        self.bat = find_battery()

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        self.add(main_box)

        # Metrics card
        metrics = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=20, homogeneous=True)
        metrics.get_style_context().add_class('card')
        self.bat_label, self.bat_status = self._metric(metrics, "CURRENT CHARGE", 'metric-value-bat')
        self.lim_label, self.lim_status = self._metric(metrics, "HARDWARE LIMIT", 'metric-value-lim')
        main_box.pack_start(metrics, False, False, 0)

        self.health_label = Gtk.Label(label="Reading battery statistics...")
        self.health_label.get_style_context().add_class('desc-text')
        main_box.pack_start(self.health_label, False, False, 0)

        # Options card
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        card.get_style_context().add_class('card')
        title = Gtk.Label(label="Select Charge Control Limit", xalign=0)
        title.get_style_context().add_class('section-title')
        card.pack_start(title, False, False, 0)

        self.radios = {}
        group = None
        for value, name, desc, recommended in OPTIONS:
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            radio = Gtk.RadioButton.new_from_widget(group)
            group = group or radio
            text = f"<b>{name}</b>"
            if recommended:
                text += "  <span weight='bold' foreground='#22c55e'>(Recommended)</span>"
            lbl = Gtk.Label(xalign=0)
            lbl.set_markup(text)
            radio.add(lbl)
            d = Gtk.Label(label=desc, xalign=0, margin_start=26)
            d.get_style_context().add_class('desc-text')
            box.pack_start(radio, False, False, 0)
            box.pack_start(d, False, False, 0)
            card.pack_start(box, False, False, 0)
            self.radios[value] = radio
        main_box.pack_start(card, False, False, 0)

        btn_box = Gtk.Box(halign=Gtk.Align.CENTER)
        self.apply_btn = Gtk.Button(label="Apply Charge Limit")
        self.apply_btn.get_style_context().add_class('suggested-action')
        self.apply_btn.connect("clicked", self.on_apply_clicked)
        btn_box.pack_start(self.apply_btn, False, False, 0)
        main_box.pack_start(btn_box, False, False, 0)

        footer = Gtk.Label(label="Hardware protection via the ASUS WMI kernel driver • saved in /etc/asus-battery-limit.conf")
        footer.get_style_context().add_class('desc-text')
        main_box.pack_start(footer, False, False, 0)

        self._radios_synced = False
        self.update_stats()
        GLib.timeout_add_seconds(3, self.update_stats)

    def _metric(self, parent, title, value_class):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        t = Gtk.Label(label=title)
        t.get_style_context().add_class('metric-title')
        v = Gtk.Label(label="-- %")
        v.get_style_context().add_class(value_class)
        s = Gtk.Label(label="")
        s.get_style_context().add_class('desc-text')
        for w in (t, v, s):
            box.pack_start(w, False, False, 0)
        parent.pack_start(box, True, True, 0)
        return v, s

    def update_stats(self):
        if not self.bat:
            self.health_label.set_text("Charge threshold is not supported on this device.")
            self.apply_btn.set_sensitive(False)
            return True

        b = lambda n: os.path.join(self.bat, n)
        self.bat_label.set_text(f"{read(b('capacity'), '--')}%")
        self.bat_status.set_text("Connected / AC Online" if ac_online() else "Discharging / Battery")

        thresh = read(b('charge_control_end_threshold'), '--')
        self.lim_label.set_text(f"{thresh}%")
        self.lim_status.set_text("Hardware Limit Enforced")

        # Sync radios only once (and after Apply) so the user's pending choice is not overwritten.
        if not self._radios_synced:
            self.radios.get(thresh, self.radios["80"]).set_active(True)
            self._radios_synced = True

        full = read(b('energy_full')) or read(b('charge_full'))
        design = read(b('energy_full_design')) or read(b('charge_full_design'))
        health = "--"
        if full and design and int(design) > 0:
            health = f"{int(full) * 100 / int(design):.1f}%"

        power = "--"
        pn = read(b('power_now'))
        if pn and pn.lstrip('-').isdigit():
            power = f"{abs(int(pn)) / 1_000_000:.1f} W"

        cycles = read(b('cycle_count'), '--')
        self.health_label.set_text(f"Health: {health}  •  Cycle Count: {cycles}  •  Power: {power}")
        return True

    def on_apply_clicked(self, _button):
        chosen = next(v for v, r in self.radios.items() if r.get_active())
        try:
            res = subprocess.run(['pkexec', BAT_LIMIT, chosen], capture_output=True, text=True)
        except FileNotFoundError as e:
            self._error(str(e))
            return
        if res.returncode in (126, 127) and not res.stderr.strip():
            return  # authentication dialog was cancelled
        if res.returncode != 0:
            self._error(res.stderr.strip() or f"bat-limit exited with code {res.returncode}")
            return
        self._radios_synced = False
        self.update_stats()
        subprocess.run(['notify-send', '--icon=battery-good-symbolic',
                        'ASUS Battery Protection', f'Charge limit set to {chosen}%'])

    def _error(self, text):
        dialog = Gtk.MessageDialog(transient_for=self, flags=0,
                                   message_type=Gtk.MessageType.ERROR,
                                   buttons=Gtk.ButtonsType.OK,
                                   text="Failed to Set Charge Limit")
        dialog.format_secondary_text(text)
        dialog.run()
        dialog.destroy()


def main():
    win = BatteryLimitWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == '__main__':
    main()
