#!/usr/bin/env bash
# ==============================================================================
# bat-limit — ASUS battery charge threshold CLI
#   bat-limit            show status
#   sudo bat-limit 80    set and persist a new limit (40..100)
# ==============================================================================

CONF="/etc/asus-battery-limit.conf"
APPLY="/usr/local/bin/asus-battery-apply"

BAT=""
for b in /sys/class/power_supply/*; do
    if [ -f "$b/charge_control_end_threshold" ]; then BAT="$b"; break; fi
done

if [ -z "$BAT" ]; then
    echo "Error: Hardware battery charge threshold is not supported on this device." >&2
    exit 1
fi

read_val() { cat "$1" 2>/dev/null; }

if [ -z "$1" ]; then
    CURRENT=$(read_val "$BAT/charge_control_end_threshold")
    CAPACITY=$(read_val "$BAT/capacity")
    CYCLES=$(read_val "$BAT/cycle_count")
    FULL=$(read_val "$BAT/energy_full"); DESIGN=$(read_val "$BAT/energy_full_design")
    if [ -z "$FULL" ]; then FULL=$(read_val "$BAT/charge_full"); DESIGN=$(read_val "$BAT/charge_full_design"); fi
    HEALTH="N/A"
    if [ -n "$FULL" ] && [ -n "$DESIGN" ] && [ "$DESIGN" -gt 0 ]; then
        HEALTH=$(awk -v f="$FULL" -v d="$DESIGN" 'BEGIN { printf "%.1f%%", f * 100 / d }')
    fi
    echo "=================================================="
    echo "   ASUS Battery Charge Threshold Controller"
    echo "=================================================="
    echo "  Hardware Limit : ${CURRENT}%"
    echo "  Battery Level  : ${CAPACITY:-N/A}%"
    echo "  Battery Health : ${HEALTH}"
    echo "  Cycle Count    : ${CYCLES:-N/A}"
    echo "--------------------------------------------------"
    echo "Usage: sudo bat-limit <40-100>"
    echo "  sudo bat-limit 60   Maximum Longevity (always on charger)"
    echo "  sudo bat-limit 80   Balanced Protection (Recommended)"
    echo "  sudo bat-limit 100  Full Capacity (travel)"
    echo "=================================================="
    exit 0
fi

LIMIT="$1"

if ! [[ "$LIMIT" =~ ^[0-9]{1,3}$ ]] || [ "$LIMIT" -lt 40 ] || [ "$LIMIT" -gt 100 ]; then
    echo "Error: Limit must be an integer between 40 and 100 (e.g. 60, 80, 100)." >&2
    exit 1
fi

if [ "$EUID" -ne 0 ]; then
    echo "Please run with sudo: sudo bat-limit $LIMIT" >&2
    exit 1
fi

printf 'LIMIT=%s\n' "$LIMIT" > "$CONF"

if [ -x "$APPLY" ]; then
    "$APPLY"
else
    echo "$LIMIT" > "$BAT/charge_control_end_threshold"
fi

echo "Success! Charge limit set to ${LIMIT}% and saved to $CONF (persists across reboot and sleep)."
